rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── HELPER FUNCTIONS ──────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Server-side check for administrator privileges
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // ── SYSTEM & HEALTH CHECKS ────────────────────────────────────────────────
    match /test/connection {
      allow read: if true;
      allow write: if false;
    }

    // Admin bootstrap check (strictly read-only for authenticated, write only by cloud console)
    match /admins/{userId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // App configuration (read-only for all clients, admin write only)
    match /config/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── USER PROFILES & PRIVATE STUDY TRACKER DATA ────────────────────────────
    match /users/{userId} {
      // Strictly scope profile reading to the authenticated owner or platform admins
      allow read: if isOwner(userId) || isAdmin();

      // Users can create their profile, but CANNOT set entitlement, roles, or billing data
      allow create: if isOwner(userId) &&
        !request.resource.data.keys().hasAny([
          'role', 'isAdmin', 'betaAccess', 'paymentStatus', 'hasPaidAccess',
          'betaAccessExpiresAt', 'vaultActivationRequired', 'dodoPaymentId',
          'dodoAmount', 'paidAt', 'paymentMethod'
        ]);

      allow update: if isAdmin() || (
        isOwner(userId) &&
        // Prevent role tampering
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin'])) &&
        // Strictly forbid client mutation of entitlement, payment, and license fields
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'betaAccess', 'paymentStatus', 'hasPaidAccess', 'betaAccessExpiresAt',
          'vaultActivationRequired', 'dodoPaymentId', 'dodoAmount', 'paidAt',
          'paymentMethod'
        ]))
      );

      allow delete: if isAdmin();

      // Nested subcollections: subjects, systems, curriculumSets, history, pyqYears, scoreLogs, uiPreferences, topicProgress
      // Strictly enforced: Only the authenticated owner or admin can read and write their personal study data
      match /{collectionName}/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Legacy or direct user backups
    match /backups/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // ── CLOSED BETA PAYMENT SUBMISSIONS ───────────────────────────────────────
    match /payments/{paymentId} {
      // Students can view their own payment submissions; admins can view all
      allow read: if isAuthenticated() && (
        resource == null ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );

      // Authenticated users can submit a payment with their own userId and 'pending' status
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.upiReference is string &&
        request.resource.data.upiReference.size() > 0 &&
        request.resource.data.proofUrl is string &&
        request.resource.data.proofUrl.size() > 0;

      // Only admins can approve, reject, or delete payment submissions
      allow update, delete: if isAdmin();
    }

    // ── COMMUNITY INSIGHT MARKERS ─────────────────────────────────────────────
    match /insights/{insightId} {
      allow read: if true;

      // Only authenticated users can submit peer markers
      allow create: if isAuthenticated() &&
        (request.resource.data.userId == request.auth.uid || request.resource.data.userId == null) &&
        request.resource.data.content is string &&
        request.resource.data.content.size() > 0;

      // Users can vote helpful/save/report; authors and admins can update content; only author/admin can delete
      allow update: if isAuthenticated() && (
        // Allow community reactions (helpfulBy, savedBy, reportedBy arrays, status, and quality score updates)
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'helpfulBy', 'notHelpfulBy', 'savedBy', 'reportedBy', 'usefulCount', 'qualityScore', 'readCount', 'status'
        ]) ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );

      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    // ── PEER REFERRAL & STUDY PASS INVITATIONS ─────────────────────────────────
    match /referralCodes/{code} {
      // Public read so invite links can show the inviter's badge/name
      allow read: if true;

      // Created when an active student generates their referral code
      allow create: if isAuthenticated() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.totalClaimed == 0;

      // Only allow updating counters; owner cannot be hijacked
      allow update: if isAuthenticated() &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalClaimed', 'lastClaimedAt']);
      allow delete: if isAdmin();
    }

    match /referrals/{referralId} {
      // Users can view referrals they sent or received; Admins can view all
      allow read: if isAuthenticated() && (
        resource.data.referrerUid == request.auth.uid ||
        resource.data.refereeUid == request.auth.uid ||
        isAdmin()
      );

      // Created upon claiming an invitation pass
      allow create: if isAuthenticated() &&
        request.resource.data.refereeUid == request.auth.uid;

      // Updated upon session qualification
      allow update: if isAuthenticated() && (
        resource.data.refereeUid == request.auth.uid ||
        resource.data.referrerUid == request.auth.uid ||
        isAdmin()
      );

      allow delete: if isAdmin();
    }

    // ── CONTACT & SUPPORT INQUIRIES ───────────────────────────────────────────
    match /contact_messages/{messageId} {
      // Allow candidates and visitors to send support tickets with validated content
      allow create: if
        request.resource.data.name is string && request.resource.data.name.size() > 0 &&
        request.resource.data.email is string && request.resource.data.email.size() > 0 &&
        request.resource.data.message is string && request.resource.data.message.size() > 0 &&
        request.resource.data.status == 'unread';

      // Only administrators can review, modify status, or delete support messages
      allow read, update, delete: if isAdmin();
    }

    // ── ANONYMIZED COHORT TELEMETRY LOGS ──────────────────────────────────────
    match /telemetry_logs/{logId} {
      allow create: if isAuthenticated() &&
        request.resource.data.events_count is int &&
        request.resource.data.cohort_id is string;

      allow read, update, delete: if isAdmin();
    }

    // ── AMBASSADOR APPLICATIONS ──────────────────────────────────────────────
    match /ambassador_applications/{applicationId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.institution is string && request.resource.data.institution.size() > 0 &&
        request.resource.data.role is string && request.resource.data.role.size() > 0;
        
      allow update, delete: if isAdmin();
    }
  }
}
