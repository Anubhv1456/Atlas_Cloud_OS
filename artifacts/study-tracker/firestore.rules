rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if the user is an admin via Firebase Custom Claims or designated document
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // App configuration (read public, write admin only)
    match /config/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admins Collection (read authenticated, write admin only)
    match /admins/{userId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // User profiles and nested subcollections
    match /users/{userId} {
      allow read: if true;
      allow write: if isOwner(userId) || isAdmin();
      
      match /{collectionName}/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Legacy backup collection
    match /backups/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Community markers / insights
    match /insights/{insightId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if isAdmin();
    }

    // Contact / Support Messages submitted via Contact page
    match /contact_messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Payment Proof Submissions
    match /payments/{paymentId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Cohort Telemetry Logs (create authenticated, admin only read/manage)
    match /telemetry_logs/{logId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isAdmin();
    }
  }
}

