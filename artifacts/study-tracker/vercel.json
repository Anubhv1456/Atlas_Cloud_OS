{
  "headers": [
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(pwa-.*|apple-touch-icon.*|favicon.*)\\.(png|ico|svg)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://atlas-cloud-6f1c6.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/apple-touch-icon",
      "destination": "/apple-touch-icon.png"
    },
    {
      "source": "/apple-touch-icon-precomposed",
      "destination": "/apple-touch-icon-precomposed.png"
    },
    {
      "source": "/apple-touch-icon-:size",
      "destination": "/apple-touch-icon-:size.png"
    },
    {
      "source": "/((?!assets/|apple-touch-icon|pwa-|favicon|manifest\\.json|.*\\.[\\w]+$).*)",
      "destination": "/index.html"
    }
  ]
}
