rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if the user is an admin
    function isAdmin() {
      return request.auth != null && (
        (request.auth.token.admin == true) || 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Test connection check
    match /test/connection {
      allow read: if true;
    }

    // Admin bootstrap check
    match /admins/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
    }
    
    // App configuration
    match /config/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User profile and backup document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read, write: if isAdmin();
      
      // User nested subcollections (e.g. subjects, systems, history, pyqYears, scoreLogs, uiPreferences)
      match /{collectionName}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        allow read, write: if isAdmin();
      }
    }

    // Legacy or secondary backup collection
    match /backups/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Community markers / insights
    match /insights/{insightId} {
      allow read: if true;
      allow create: if request.auth != null;
      
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.userId || 
        isAdmin() ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usefulCount', 'helpfulBy', 'notHelpfulBy', 'savedBy', 'reportedBy', 'readCount', 'qualityScore', 'status']))
      );
      
      allow delete: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());
    }

    // Contact / Support Messages submitted via Contact page
    match /contact_messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
