rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if the user is an admin
    function isAdmin() {
      return request.auth != null && (
        (request.auth.token.admin == true) || 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Test connection check
    match /test/connection {
      allow read, write: if true;
    }

    // Admin bootstrap check
    match /admins/{userId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    
    // App configuration (featureFlags, socials, announcements, etc.)
    match /config/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User profiles and subcollections
    match /users/{userId} {
      // Allow reading profiles so author names can be shown across community features
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      
      // User nested subcollections (e.g. subjects, systems, history, pyqYears, scoreLogs, uiPreferences, topicProgress)
      match /{collectionName}/{docId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
    }

    // Legacy or secondary backup collection
    match /backups/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Community markers / insights
    match /insights/{insightId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Contact / Support Messages submitted via Contact page
    match /contact_messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null && isAdmin();
    }

    // Payment Submissions for Closed Beta
    match /payments/{paymentId} {
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}
